<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VFED_RecruitAssassinationTarget</AssemblyName>
    <RootNamespace>VFED_RecruitAssassinationTarget</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- RimWorld 1.5 -->
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.5'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.*" ExcludeAssets="runtime" />
    <Reference Include="VFED">
      <HintPath>D:\SteamLibrary\steamapps\workshop\content\294100\3025493377\1.5\Assemblies\VFED.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- RimWorld 1.6 (also loaded on RimWorld 1.7 via LoadFolders.xml, matching VFED) -->
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" />
    <Reference Include="VFED">
      <HintPath>D:\SteamLibrary\steamapps\workshop\content\294100\3025493377\1.6\Assemblies\VFED.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
